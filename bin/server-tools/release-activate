#!/usr/bin/env bash
set -euo pipefail

# Usage: wps release:activate <site-name> <release-timestamp> [--json]
# Makes an already-built release (sitting in releases/<timestamp>) the
# live one: swaps the current symlink, restarts/reloads services,
# records the release timestamp, and clears plugin caches. Used by both
# finish-deploy (after building a brand new release) and release:rollback
# (when re-pointing to an existing older one) — kept in one place so the
# two never drift out of sync on what "going live" actually requires.

# shellcheck source=bin/server-tools/_lib.sh
. "$(dirname "$0")/_lib.sh"

_args=()
for _a in "$@"; do
    if [ "$_a" = "--json" ]; then JSON_MODE=true; else _args+=("$_a"); fi
done
set -- "${_args[@]+"${_args[@]}"}"

SITE_NAME="${1:-}"
RELEASE_TS="${2:-}"
SITES_ROOT="/var/www"

if [ -z "$SITE_NAME" ] || [ -z "$RELEASE_TS" ]; then
    echo "Usage: wps release:activate <site-name> <release-timestamp> [--json]" >&2
    exit 1
fi

SITE_DIR="$SITES_ROOT/$SITE_NAME"
RELEASE_DIR="$SITE_DIR/releases/$RELEASE_TS"

if [ ! -d "$RELEASE_DIR" ]; then
    echo "ERROR: $RELEASE_DIR does not exist" >&2
    exit 1
fi
if [ ! -f "$RELEASE_DIR/wp-config.php" ]; then
    echo "ERROR: $RELEASE_DIR is missing wp-config.php — refusing to activate a broken release" >&2
    exit 1
fi

SITE_USER="$(stat -c '%U' "$RELEASE_DIR/public")"

if [ ! -f "$RELEASE_DIR/public/wp-load.php" ] || \
   [ ! -d "$RELEASE_DIR/public/wp-includes" ] || \
   [ ! -d "$RELEASE_DIR/public/wp-admin" ]; then
    log "WordPress core missing from release — downloading directly..."
    sudo -u "$SITE_USER" wp core download --path="$RELEASE_DIR/public" --force
fi

ln -sfn "$RELEASE_DIR" "$SITE_DIR/current"
chown -h "$SITE_USER":"$SITE_USER" "$SITE_DIR/current"
log "Swapped current -> $RELEASE_DIR"

log "Recording release timestamp..."
sudo -u "$SITE_USER" wp --path="$RELEASE_DIR/public" option update av_latest_release_timestamp "$RELEASE_TS" --autoload=yes --quiet

log "Restarting php8.5-fpm and reloading nginx..."
systemctl restart php8.5-fpm
systemctl reload nginx

if [ -e "$RELEASE_DIR/content/plugins/cache-enabler" ] || [ -e "$RELEASE_DIR/content/plugins/autoptimize" ]; then
    log "Clearing Cache Enabler / Autoptimize cache..."
    rm -rf "${RELEASE_DIR:?}/content/cache"
fi
sudo -u "$SITE_USER" wp --path="$RELEASE_DIR/public" cache flush --quiet || true

log "Activated release $RELEASE_TS for $SITE_NAME"

if $JSON_MODE; then
    printf '{"site":%s,"release":%s,"status":"activated","events":%s}\n' \
        "$(json_str "$SITE_NAME")" \
        "$(json_str "$RELEASE_TS")" \
        "$(json_events_array)"
fi
