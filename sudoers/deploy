# Allows DEPLOY_USER to run finish-deploy as root without a password,
# invoked by the GitHub Actions workflow over non-interactive SSH.
# No arguments specified here means any arguments are permitted — same
# pattern as the backups rule, which already works this way. The
# script itself gets copied to this fixed path fresh on every deploy;
# the actual build content stays in its own per-run staging directory
# and is passed to the script as an argument, not matched by sudoers.
# (Ubuntu 26.04's sudo-rs does not support wildcards in sudoers rules
# at all, so an earlier wildcarded-staging-path approach couldn't work.)
# Path is under the deploy user's home directory rather than /tmp so
# it is not world-writable and cannot be replaced by another local user.

DEPLOY_USER ALL=(root) NOPASSWD: /home/DEPLOY_USER/finish-deploy
