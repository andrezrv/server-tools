#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=bin/server-tools/_lib.sh
. "$(dirname "$0")/_lib.sh"

_args=()
for _a in "$@"; do
    if [ "$_a" = "--json" ]; then JSON_MODE=true; else _args+=("$_a"); fi
done
set -- "${_args[@]+"${_args[@]}"}"
parse_opts "$@"

DOMAIN="${1:-}"
if [ -z "$DOMAIN" ]; then
    echo "Usage: wps site:install <domain> [--json]" >&2
    exit 1
fi

SITE_DIR="/var/www/$DOMAIN"
if [ ! -d "$SITE_DIR" ]; then
    echo "ERROR: $SITE_DIR does not exist — run wps site:provision first" >&2
    exit 1
fi
if [ -f "$SITE_DIR/unmanaged" ]; then
    echo "ERROR: $DOMAIN is already installed as an unmanaged site" >&2
    exit 1
fi
if ! command -v composer >/dev/null 2>&1; then
    echo "ERROR: composer not found on PATH" >&2
    exit 1
fi
if ! command -v wp >/dev/null 2>&1; then
    echo "ERROR: wp-cli not found on PATH" >&2
    exit 1
fi

SITE_USER=""
if [ -L "$SITE_DIR/current" ]; then
    SITE_USER="$(stat -c '%U' "$(readlink -f "$SITE_DIR/current")/public" 2>/dev/null || true)"
fi
SLUG="${SITE_USER%-site}"
if [ -z "$SITE_USER" ]; then
    echo "ERROR: could not determine site user from $SITE_DIR/current — is the site provisioned?" >&2
    exit 1
fi

if [ -f "/etc/letsencrypt/live/$DOMAIN/fullchain.pem" ]; then
    SITE_URL="https://$DOMAIN"
else
    SITE_URL="http://$DOMAIN"
fi

ZIP_URL="https://github.com/andrezrv/wp-boilerplate/archive/refs/heads/main.zip"

TMP_DIR="$(mktemp -d /var/www/.staging-XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT
ZIP="$TMP_DIR/main.zip"

log "Downloading WP Boilerplate..."
curl -fL -o "$ZIP" "$ZIP_URL"

log "Extracting..."
unzip -q "$ZIP" -d "$TMP_DIR"
STAGING="$TMP_DIR/wp-boilerplate-main"

log "Generating temporary secrets.php..."
{ printf '<?php\n'; curl -s https://api.wordpress.org/secret-key/1.1/salt/; } \
    > "$STAGING/config/secrets.php"

cp "$SITE_DIR/.env.production" "$STAGING/.env.production"

log "Handing staging directory to $SITE_USER..."
chown -R "$SITE_USER":"$SITE_USER" "$TMP_DIR"

log "Installing dependencies..."
sudo -u "$SITE_USER" composer --working-dir="$STAGING" update --no-interaction --no-dev

if [ ! -f "$STAGING/public/wp-load.php" ] || \
   [ ! -d "$STAGING/public/wp-includes" ] || \
   [ ! -d "$STAGING/public/wp-admin" ]; then
    echo "ERROR: WordPress core is missing or incomplete in public/ after composer — aborting deploy." >&2
    exit 1
fi

echo ""
echo "WordPress install for $DOMAIN"
echo ""
ADMIN_USER="$(get_opt admin_user)"
if [ -z "$ADMIN_USER" ]; then
    read -r -p "Admin username: " ADMIN_USER
fi
if [ -z "$ADMIN_USER" ]; then
    echo "ERROR: admin username cannot be empty" >&2
    exit 1
fi
ADMIN_PASS="$(get_opt admin_pass)"
if [ -z "$ADMIN_PASS" ]; then
    read -r -s -p "Admin password: " ADMIN_PASS
    echo ""
    if [ -z "$ADMIN_PASS" ]; then
        echo "ERROR: admin password cannot be empty" >&2
        exit 1
    fi
    read -r -s -p "Confirm password: " ADMIN_PASS_CONFIRM
    echo ""
    if [ "$ADMIN_PASS" != "$ADMIN_PASS_CONFIRM" ]; then
        echo "ERROR: passwords do not match" >&2
        exit 1
    fi
fi
if [ -z "$ADMIN_PASS" ]; then
    echo "ERROR: admin password cannot be empty" >&2
    exit 1
fi
ADMIN_EMAIL="$(get_opt admin_email)"
if [ -z "$ADMIN_EMAIL" ]; then
    read -r -p "Admin email: " ADMIN_EMAIL
fi
if [ -z "$ADMIN_EMAIL" ]; then
    echo "ERROR: admin email cannot be empty" >&2
    exit 1
fi

log "Running wp core install..."
sudo -u "$SITE_USER" wp --path="$STAGING/public" --url="$SITE_URL" core install \
    --title="$DOMAIN" \
    --admin_user="$ADMIN_USER" \
    --admin_password="$ADMIN_PASS" \
    --admin_email="$ADMIN_EMAIL" \
    --skip-email

THEME_SLUG="$(get_opt theme)"
INSTALLED_THEMES="$(sudo -u "$SITE_USER" wp --path="$STAGING/public" theme list --field=name 2>/dev/null || true)"
if [ -n "$INSTALLED_THEMES" ] && [ -z "$THEME_SLUG" ]; then
    echo ""
    echo "Installed themes:"
    printf '%s\n' "$INSTALLED_THEMES"
    echo ""
    read -r -p "Theme to activate (leave blank to skip): " THEME_SLUG
fi
if [ -n "$THEME_SLUG" ]; then
    sudo -u "$SITE_USER" wp --path="$STAGING/public" theme activate "$THEME_SLUG"
    log "Activated theme: $THEME_SLUG"
fi

rm -f "$STAGING/.env.production"

log "Running finish-deploy..."
"$STAGING/bin/finish-deploy" "$DOMAIN" "$STAGING" production

log "Marking site as unmanaged..."
touch "$SITE_DIR/unmanaged"
chown "$SITE_USER":"$SITE_USER" "$SITE_DIR/unmanaged"

CRON_FILE="/etc/cron.d/wps-update-$SLUG"
log "Setting up daily auto-update cron..."
printf '0 3 * * * root /usr/local/bin/wps site:update %s >> /var/log/deploy-%s.log 2>&1\n' \
    "$DOMAIN" "$DOMAIN" > "$CRON_FILE"
chmod 644 "$CRON_FILE"

log "Install complete for $DOMAIN ($SITE_URL)"
log "Auto-update scheduled daily at 03:00 via $CRON_FILE"

if $JSON_MODE; then
    printf '{"domain":%s,"site_url":%s,"site_user":%s,"slug":%s,"theme_activated":%s,"auto_update_cron":%s,"status":"ok","events":%s}\n' \
        "$(json_str "$DOMAIN")" \
        "$(json_str "$SITE_URL")" \
        "$(json_str "$SITE_USER")" \
        "$(json_str "$SLUG")" \
        "$(json_str "$THEME_SLUG")" \
        "$(json_str "$CRON_FILE")" \
        "$(json_events_array)"
fi
