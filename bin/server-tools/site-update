#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=bin/server-tools/_lib.sh
. "$(dirname "$0")/_lib.sh"

_args=()
for _a in "$@"; do
    if [ "$_a" = "--json" ]; then JSON_MODE=true; else _args+=("$_a"); fi
done
set -- "${_args[@]+"${_args[@]}"}"

DOMAIN="${1:-}"
if [ -z "$DOMAIN" ]; then
    echo "Usage: wps site:update <domain> [--json]" >&2
    exit 1
fi

SITE_DIR="/var/www/$DOMAIN"
if [ ! -d "$SITE_DIR" ]; then
    echo "ERROR: $SITE_DIR does not exist" >&2
    exit 1
fi
if [ ! -f "$SITE_DIR/unmanaged" ]; then
    echo "$DOMAIN is not an unmanaged site — skipping." >&2
    exit 0
fi
if ! command -v composer >/dev/null 2>&1; then
    echo "ERROR: composer not found on PATH" >&2
    exit 1
fi

SITE_USER=""
if [ -L "$SITE_DIR/current" ]; then
    SITE_USER="$(stat -c '%U' "$(readlink -f "$SITE_DIR/current")/public" 2>/dev/null || true)"
fi
if [ -z "$SITE_USER" ]; then
    echo "ERROR: could not determine site user from $SITE_DIR/current — is the site provisioned?" >&2
    exit 1
fi

ZIP_URL="https://github.com/andrezrv/wp-boilerplate/archive/refs/heads/main.zip"

TMP_DIR="$(mktemp -d /var/www/.staging-XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT
ZIP="$TMP_DIR/main.zip"

log "Downloading WP Boilerplate..."
curl -fL -o "$ZIP" "$ZIP_URL"

log "Extracting..."
unzip -q "$ZIP" -d "$TMP_DIR"
STAGING="$TMP_DIR/wp-boilerplate-main"

log "Handing staging directory to $SITE_USER..."
chown -R "$SITE_USER":"$SITE_USER" "$TMP_DIR"

log "Installing dependencies..."
sudo -u "$SITE_USER" composer --working-dir="$STAGING" update --no-interaction --no-dev

_UPDATE_STATUS="ok"
_UPDATE_ERROR=""
_ROLLBACK_STATUS=""

log "Running finish-deploy..."
if ! "$STAGING/bin/finish-deploy" "$DOMAIN" "$STAGING" production; then
    _UPDATE_STATUS="error"
    _UPDATE_ERROR="update failed"
    log "ERROR: update failed — attempting rollback to previous release..."
    if wps release:rollback "$DOMAIN"; then
        _ROLLBACK_STATUS="ok"
    else
        _ROLLBACK_STATUS="failed"
        log "WARNING: rollback also failed — manual intervention required"
    fi
fi

if [ "$_UPDATE_STATUS" = "ok" ]; then
    log "Update complete for $DOMAIN"
fi

if $JSON_MODE; then
    if [ "$_UPDATE_STATUS" = "ok" ]; then
        printf '{"domain":%s,"status":"ok","events":%s}\n' \
            "$(json_str "$DOMAIN")" \
            "$(json_events_array)"
    else
        printf '{"domain":%s,"status":"error","error":%s,"rollback_status":%s,"events":%s}\n' \
            "$(json_str "$DOMAIN")" \
            "$(json_str "$_UPDATE_ERROR")" \
            "$(json_str "$_ROLLBACK_STATUS")" \
            "$(json_events_array)"
    fi
fi

[ "$_UPDATE_STATUS" = "ok" ] || exit 1
